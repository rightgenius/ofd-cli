<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ofdcli</groupId>
    <artifactId>ofd-cli</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>

    <name>ofd-cli</name>
    <description>Command-line tool for OFD (Open Fixed-layout Document) processing, built on ofdrw</description>
    <url>https://github.com/ofdcli/ofd-cli</url>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>

        <picocli.version>4.7.6</picocli.version>
        <!-- ofdrw fork: 2.4.0-openpdf.6 from rightgenius/ofdrw replaces
             PDFBox with OpenPDF in the OFD→PDF exporter (PDFExporterOpenPDF),
             making to-pdf work in GraalVM native-image. PDF→OFD is broken
             in this variant (PDFConverter is a stub).
             Resolved via local mvn install in CI (fork is cloned + mvn install
             from the tagged release); JitPack is no longer used. -->
        <ofdrw.version>2.4.0-openpdf.6</ofdrw.version>
        <jackson.version>2.16.1</jackson.version>

        <native.maven.plugin.version>0.10.2</native.maven.plugin.version>
        <git.commit.id.plugin.version>4.9.10</git.commit.id.plugin.version>
        <build.timestamp>${maven.build.timestamp}</build.timestamp>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ssXXX</maven.build.timestamp.format>
    </properties>

    <dependencies>
        <!-- CLI framework -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>

        <!-- JUnit 5 for Java-side unit tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <!-- picocli annotation processor: auto-generates GraalVM reflect/resource/proxy configs -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <version>${picocli.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- rightgenius/ofdrw 2.4.0-openpdf.6 (PDFBox -> OpenPDF fork + native verify/validate).
             Built and installed to local m2 by .github/workflows/release.yml
             from the tagged fork release; no remote repo lookup. -->
        <dependency>
            <groupId>com.github.rightgenius</groupId>
            <artifactId>ofdrw-full</artifactId>
            <version>${ofdrw.version}</version>
        </dependency>

        <!-- ofdrw-crypto: same fork, same source. -->
        <dependency>
            <groupId>com.github.rightgenius</groupId>
            <artifactId>ofdrw-crypto</artifactId>
            <version>${ofdrw.version}</version>
        </dependency>

        <!-- JSON output for AI / scripting -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <repositories>
        <!-- (no remote repos) — the rightgenius/ofdrw fork is built and
             installed to the local m2 by .github/workflows/release.yml
             before mvn package runs. -->
    </repositories>

    <build>
        <finalName>ofd-cli</finalName>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- picocli annotation processor: generates GraalVM metadata in target/classes/META-INF/native-image/... -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Resolve ${git.commit.id.abbrev} at build time -->
            <plugin>
                <groupId>pl.project13.maven</groupId>
                <artifactId>git-commit-id-plugin</artifactId>
                <version>${git.commit.id.plugin.version}</version>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals><goal>revision</goal></goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <dateFormat>${maven.build.timestamp.format}</dateFormat>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                </configuration>
            </plugin>

            <!-- GraalVM native-image (mvn -Pnative package) -->
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <version>${native.maven.plugin.version}</version>
                <configuration>
                    <imageName>ofd</imageName>
                    <mainClass>io.github.ofdcli.Main</mainClass>
                    <buildArgs combine.children="append">
                        <buildArg>--no-fallback</buildArg>
                        <buildArg>--install-exit-handlers</buildArg>
                        <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                        <buildArg>-H:+AddAllCharsets</buildArg>
                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                        <!-- BouncyCastleProvider 用于 validate 的 MAC 计算
                             和 JCE SM3 入口（即使走 lightweight API 也要 BC provider 给
                             MessageDigest.getInstance 算 Reference SM3）。 -->
                        <buildArg>-H:AdditionalSecurityProviders=org.bouncycastle.jce.provider.BouncyCastleProvider</buildArg>
                        <buildArg>--enable-all-security-services</buildArg>
                    </buildArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>build-native</id>
                        <goals><goal>build</goal></goals>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- fat-jar fallback (java -jar target/ofd-cli.jar) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.ofdcli.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Activate with: mvn -Pnative package -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <phase>package</phase>
                                <goals><goal>build</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
